{
  "version": 2,
  "name": "studygenie-bot",
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "app.py"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "env": {
    "BOT_TOKEN": "@bot_token",
    "GOOGLE_API_KEY": "@google_api_key",
    "REDIS_URL": "@redis_url"
  }
}
