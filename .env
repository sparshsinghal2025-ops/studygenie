# Required
BOT_TOKEN=your_telegram_bot_token_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional
ENV=development
PRODUCTION_MODE=0
REDIS_URL=redis://localhost:6379
DATABASE_URL=

# Quota
FREE_DAILY_QUESTIONS=10
FREE_LIFETIME_QUESTIONS=30
PRO_PRICE_INR=49

# Speed
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=15
CACHE_ENABLED=1
